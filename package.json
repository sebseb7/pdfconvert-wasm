{
  "name": "pdfconvert-wasm",
  "version": "0.2.0",
  "description": "WebAssembly PDF to text and PDF to PNG converter based on poppler-cpp",
  "type": "module",
  "main": "./index.node.js",
  "module": "./index.js",
  "exports": {
    ".": {
      "node": "./index.node.js",
      "default": "./index.js"
    },
    "./poppler.wasm": "./poppler.wasm"
  },
  "files": [
    "index.js",
    "index.node.js",
    "node-worker-client.js",
    "node-worker.js",
    "poppler.js",
    "poppler.wasm",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "docker build -o . .",
    "build:docker": "docker build -o . .",
    "test": "node test/scripts/compare-text.js && node test/scripts/compare-images.js",
    "test:compare:images": "node test/scripts/compare-images.js",
    "test:compare:text": "node test/scripts/compare-text.js",
    "test:generate": "npm run test:generate:images && npm run test:generate:text",
    "test:generate:images": "node test/scripts/generate-images.js",
    "test:generate:text": "node test/scripts/generate-text.js",
    "bench:node": "node test/benchmark/bench-node.js",
    "bench:browser": "node test/benchmark/bench-browser.js",
    "bench:report": "node test/benchmark/report.js",
    "bench:compare-os": "node test/benchmark/compare-os.js",
    "bench:compare-wasm": "node test/benchmark/compare-wasm.js",
    "bench:compare-os-images": "node test/benchmark/compare-os-images.js",
    "bench": "npm run bench:node && npm run bench:browser && npm run bench:report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebseb7/pdfconvert-wasm.git"
  },
  "bugs": {
    "url": "https://github.com/sebseb7/pdfconvert-wasm/issues"
  },
  "homepage": "https://github.com/sebseb7/pdfconvert-wasm#readme",
  "keywords": [
    "pdf",
    "poppler",
    "poppler-cpp",
    "wasm",
    "webassembly",
    "pdf-to-text",
    "pdf-to-png",
    "pdf-to-image"
  ],
  "license": "GPLv3",
  "devDependencies": {
    "diff": "^9.0.0",
    "pdfjs-dist": "^4.0.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.40.0",
    "pngjs": "^7.0.0"
  }
}
